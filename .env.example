# Firebase web config (Project settings → General → Your apps)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Local development against the Firebase emulators (pnpm emulators)
VITE_USE_EMULATORS=false

# Server only (Vercel env): service account JSON encoded in base64
FIREBASE_SERVICE_ACCOUNT=

# Server only, when using the emulators locally
# FIREBASE_PROJECT_ID=demo-penny
# FIRESTORE_EMULATOR_HOST=127.0.0.1:8080
# FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099
