rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isOwner(uid) {
      return request.auth != null && request.auth.uid == uid;
    }

    function isMonthKey(value) {
      return value is string && value.matches('^[0-9]{4}-[0-9]{2}$');
    }

    function validExpense(data) {
      return data.amount is number && data.amount > 0
        && data.amountARS is number
        && data.amountUSD is number
        && data.currency in ['ARS', 'USD']
        && data.date is timestamp
        && isMonthKey(data.month)
        && data.description is string && data.description.size() <= 200
        && data.category in ['food', 'groceries', 'car', 'transport', 'personal_care', 'health', 'home',
                             'utilities', 'entertainment', 'clothing', 'education', 'travel', 'gifts', 'pets', 'other']
        && data.paymentMethod in ['credit', 'debit', 'wallet', 'cash']
        && data.necessary is bool
        && data.source in ['app', 'api', 'subscription']
        && data.rate is map && data.rate.value is number;
    }

    match /users/{uid} {
      allow read, create, update: if isOwner(uid);

      // API key in plain text so the owner can see it; only the server writes it.
      match /private/{docId} {
        allow read: if isOwner(uid);
        allow write: if false;
      }

      match /expenses/{expenseId} {
        allow read, delete: if isOwner(uid);
        allow create, update: if isOwner(uid) && validExpense(request.resource.data);
      }

      match /budgets/{month} {
        allow read, delete: if isOwner(uid);
        allow create, update: if isOwner(uid) && isMonthKey(month) && request.resource.data.month == month;
      }

      match /subscriptions/{subscriptionId} {
        allow read, write: if isOwner(uid);
      }
    }

    // Hashed API keys, resolved only by the server with the Admin SDK.
    match /apiKeys/{hash} {
      allow read, write: if false;
    }
  }
}
